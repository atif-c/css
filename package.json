{
	"name": "@atifc/css",
	"version": "1.0.3",
	"description": "Parametric CSS design token system built on OKLCH with dark/light theming and zero dependencies.",
	"author": "Atif C <atifcdev@gmail.com>",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atif-c/css.git"
	},
	"bugs": {
		"url": "https://github.com/atif-c/css/issues"
	},
	"homepage": "https://github.com/atif-c/css#readme",
	"main": "dist/root.css",
	"style": "dist/root.css",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"style": "./dist/root.css",
			"css": "./dist/root.css",
			"default": "./dist/root.css"
		}
	},
	"sideEffects": true,
	"files": [
		"dist",
		"index.d.ts"
	],
	"keywords": [
		"css",
		"design-tokens",
		"css-variables",
		"oklch",
		"dark-mode",
		"theming"
	],
	"scripts": {
		"build": "lightningcss --minify --bundle --targets \"Chrome >= 111, Safari >= 16.4, Firefox >= 113\" src/root.css -o dist/root.css",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"lightningcss-cli": "^1.33.0",
		"prettier": "^3.9.6"
	}
}
